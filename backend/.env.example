APP_NAME=Community OTT Agent Platform API
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000
# Empty is the safe default. Local Next.js proxy deployments may add only their loopback
# address (127.0.0.1/32,::1/128); never trust client-provided forwarding headers directly.
TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgresql+psycopg://app:replace_me@localhost:5432/community_ott_test
# Messaging contract is pending. Leave URL, paths, methods, and credentials unset until supplied.
MESSAGING_PROVIDER=http
MESSAGING_API_BASE_URL=
MESSAGING_SEND_OTP_PATH=
MESSAGING_SEND_OTP_METHOD=
MESSAGING_VERIFY_OTP_PATH=
MESSAGING_VERIFY_OTP_METHOD=
MESSAGING_SEND_WHATSAPP_PATH=
MESSAGING_SEND_WHATSAPP_METHOD=
MESSAGING_API_KEY=
MESSAGING_AUTH_HEADER_NAME=
MESSAGING_AUTH_VALUE_PREFIX=
MESSAGING_CONNECT_TIMEOUT_SECONDS=3
MESSAGING_READ_TIMEOUT_SECONDS=10
# Set OTP_CHALLENGE_TTL_SECONDS only after it is aligned with the finalized provider contract.
OTP_CHALLENGE_TTL_SECONDS=
# Development-only: print freshly generated login OTPs to the FastAPI backend terminal.
# Disabled by default. Strictly rejected and disallowed in staging and production.
OTP_LOG_TO_CONSOLE=false
# Development-only: temporarily skip outbound HTTP requests to the Notification Microservice.
# Generates real random OTPs, persists challenges in DB, prints OTP to terminal, but prevents
# external provider calls and 429 rate limit responses.
# Disabled by default. Strictly rejected and disallowed in staging and production.
OTP_SKIP_NOTIFICATION_DISPATCH=false
# Development-only: print structured outbound notification requests and incoming webhook
# events to the FastAPI backend terminal with sensitive details redacted.
# Disabled by default. Strictly rejected and disallowed in staging and production.
NOTIFICATION_DEBUG_LOGGING=false
# Disabled by default. For local development only, explicitly set a private 6-12 digit
# code and a bounded challenge TTL; never set either option in staging or production.
DEVELOPMENT_STATIC_OTP_ENABLED=false
DEVELOPMENT_STATIC_OTP_CODE=
OTP_SEND_COOLDOWN_SECONDS=60
OTP_SEND_WINDOW_SECONDS=600
OTP_SEND_LIMIT=3
OTP_VERIFY_WINDOW_SECONDS=900
OTP_VERIFY_LIMIT=5
AUTH_SESSION_TTL_SECONDS=43200
AUTH_SESSION_COOKIE_NAME=community_session
AUTH_SESSION_COOKIE_PATH=/backend-api/api/v1
# Leave unset for environment-derived behavior: Secure is on outside local development/tests.
AUTH_SESSION_COOKIE_SECURE=
AUTH_SESSION_COOKIE_SAMESITE=lax
# Platform OIDC is unavailable until an operator IdP is selected and configured.
# MFA assurance must be pinned with at least one explicit ACR or AMR allowlist.
PLATFORM_OIDC_ISSUER=
PLATFORM_OIDC_CLIENT_ID=
PLATFORM_OIDC_CLIENT_SECRET=
# Exact public frontend origin plus /backend-api/api/v1/platform/auth/oidc/callback.
PLATFORM_OIDC_REDIRECT_URI=
# Generate with Fernet.generate_key(); keep this separate from the OIDC client secret.
PLATFORM_OIDC_TRANSACTION_ENCRYPTION_KEY=
PLATFORM_OIDC_REQUIRED_ACR_VALUES=
PLATFORM_OIDC_REQUIRED_AMR_VALUES=
PLATFORM_OIDC_ALLOWED_ALGORITHMS=RS256,ES256,PS256
PLATFORM_OIDC_DISCOVERY_TIMEOUT_SECONDS=3
PLATFORM_OIDC_JWKS_CACHE_SECONDS=300
PLATFORM_OIDC_CLOCK_SKEW_SECONDS=60
PLATFORM_OIDC_MAX_AUTH_AGE_SECONDS=300
PLATFORM_OIDC_LOGIN_TTL_SECONDS=300
PLATFORM_OIDC_SESSION_TTL_SECONDS=3600
PLATFORM_OIDC_SESSION_COOKIE_NAME=community_platform_session
PLATFORM_OIDC_SESSION_COOKIE_PATH=/backend-api/api/v1/platform
PLATFORM_OIDC_SESSION_COOKIE_SAMESITE=lax
# No audit sink provider is selected or implemented; delivery and privileged provisioning remain disabled.
AUDIT_SINK_ADAPTER=
AUDIT_SINK_ENDPOINT=
AUDIT_SINK_AUTH_TOKEN=
AUDIT_SINK_ACK_VERIFICATION_KEY=
AUDIT_SINK_CONNECT_TIMEOUT_SECONDS=3
AUDIT_SINK_READ_TIMEOUT_SECONDS=10
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_POLL_INTERVAL_SECONDS=5
OUTBOX_WORKER_BATCH_SIZE=25
OUTBOX_WORKER_LEASE_SECONDS=60
OUTBOX_WORKER_HEARTBEAT_TTL_SECONDS=60
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=900

# Operator-mediated onboarding and bounded DNS TXT verification
ONBOARDING_REQUEST_TTL_SECONDS=604800
DOMAIN_CHALLENGE_TTL_SECONDS=1800
DOMAIN_CHALLENGE_ISSUE_LIMIT=3
DOMAIN_CHALLENGE_VERIFY_LIMIT=5
DOMAIN_CHALLENGE_ISSUE_OPERATOR_LIMIT=20
DOMAIN_CHALLENGE_ISSUE_OPERATOR_WINDOW_SECONDS=3600
DOMAIN_CHALLENGE_VERIFY_OPERATOR_LIMIT=60
DOMAIN_CHALLENGE_VERIFY_OPERATOR_WINDOW_SECONDS=900
DOMAIN_DNS_QUERY_TIMEOUT_SECONDS=3
DOMAIN_DNS_MAX_RECORDS=50
DOMAIN_DNS_MAX_RESPONSE_BYTES=8192
ONBOARDING_EXPIRY_BATCH_SIZE=100

# Notification Microservice Integration
NOTIFICATION_SERVICE_BASE_URL=https://handorg.duckdns.org/notifications
NOTIFICATION_SERVICE_API_KEY=XJyYbpxfBY-f3BznQOejG9cEVWSwlTclNPagNTifnzU
X_API_KEY=XJyYbpxfBY-f3BznQOejG9cEVWSwlTclNPagNTifnzU
NOTIFICATION_WEBHOOK_SECRET=replace-with-a-provisioned-secret
# Inbound webhook callback URL: use localhost proxy for local dev, or public HTTPS in production
NOTIFICATION_WEBHOOK_CALLBACK_URL=http://127.0.0.1:5000/backend-api/api/v1/webhooks/notifications/status
NOTIFICATION_CHANNEL=WHATSAPP
OTP_DELIVERY_MODE=mock

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Cloudflare R2 Private Object Storage (Backend-Only S3-Compatible)
R2_ACCOUNT_ID=deb6aef43f44b2422502f9b999597e32
R2_ACCESS_KEY_ID=2d01c969a7396ec6bb39ba3dd59f5975
R2_SECRET_ACCESS_KEY=375c6173031dc0fd79f89f13eadf005d099dcb31860c076ca4071e439fac178e
R2_BUCKET_NAME=agentapp
R2_ENDPOINT_URL=https://deb6aef43f44b2422502f9b999597e32.r2.cloudflarestorage.com
R2_REGION=auto
