# Next.js health and explicit local-development auth proxy upstream.
# Auth paths are unavailable unless Next runs in development and the browser host
# is loopback (localhost, *.localhost, or a loopback IP).
BACKEND_API_BASE_URL=http://127.0.0.1:8000

# Temporary compatibility routes still connect directly to MongoDB.
# Keep this local and replace it with the approved development database URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sahayak_partners

# Razorpay Standard Checkout publishable Key ID (safe for frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
